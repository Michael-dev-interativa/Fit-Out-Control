# ===== Backend (Express server.js) =====
PORT=5000

# Database LOCAL (docker-compose do projeto)
DATABASE_URL_LOCAL=postgres://postgres:postgres@localhost:5433/fitout

# Database PRINCIPAL (ex.: Neon/Render). Ex: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://fitout_user:senha@host:5432/fitout?sslmode=require

# JWT signing secret (gera um valor seguro; nunca comite o valor real)
JWT_SECRET=your-secret-key-here

# CORS: origens permitidas (comma-separated). Ex: http://localhost:5173,https://app.seudominio.com
ALLOWED_ORIGINS=http://localhost:5173

# Log de requests (true/false)
LOG_REQUESTS=false

# ===== Frontend (Vite build) =====
# IMPORTANTE: Para produção no Vercel, configure esta variável em:
# Project Settings → Environment Variables → Add New
# Key: VITE_API_URL
# Value: https://seu-backend.onrender.com (URL do seu backend em produção)
# Environments: Production, Preview, Development

# Desenvolvimento local (opcional - se não configurar, usa http://localhost:5000)
VITE_API_URL=http://localhost:5000

# Proxy local do Vite para /api e /health (opcional)
VITE_DEV_PROXY_TARGET=http://localhost:5000
