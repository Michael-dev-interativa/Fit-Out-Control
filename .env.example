# ===== Backend (Express server.js) =====
PORT=3000

# Database LOCAL (para desenvolvimento e importação do Base44)
DATABASE_URL_LOCAL=postgres://postgres:postgres@localhost:5432/fitout

# Database RENDER (produção - copie a External Database URL do Render Dashboard)
DATABASE_URL=postgresql://fitout_user:SENHA@dpg-xxxx.oregon-postgres.render.com/fitout

JWT_SECRET=your-secret-key-here

# ===== Frontend (Vite build) =====
# IMPORTANTE: Para produção no Vercel, configure esta variável em:
# Project Settings → Environment Variables → Add New
# Key: VITE_API_URL
# Value: https://seu-backend.onrender.com (URL do seu backend em produção)
# Environments: Production, Preview, Development

# Desenvolvimento local (opcional - se não configurar, usa http://localhost:3000)
VITE_API_URL=http://localhost:3000
