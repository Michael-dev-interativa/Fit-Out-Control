# Exemplo de configuração para produção
# Copie este arquivo para .env.production e ajuste os valores

# URL do backend em produção (Render/Railway/outro serviço)
VITE_API_URL=https://seu-backend.onrender.com

# Ou se o backend estiver no mesmo domínio:
# VITE_API_URL=https://seu-dominio.com

# IMPORTANTE: 
# - Não inclua "/" no final da URL
# - Esta variável DEVE estar configurada no painel do Vercel/Netlify também
# - Variáveis VITE_ são embutidas no build, não em runtime
